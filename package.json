{
  "name": "wzj-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test && npm run build && node scripts/check-build.mjs && npm run test:render",
    "new": "node scripts/new-post.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "publish-post": "node scripts/publish-post.mjs",
    "setup:diagrams": "playwright install chromium --only-shell",
    "test:render": "node scripts/check-rendering.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/rss": "4.0.19",
    "@modelcontextprotocol/sdk": "1.30.0",
    "astro": "7.3.1",
    "katex": "0.16.47",
    "playwright": "1.63.0",
    "rehype-katex": "7.0.1",
    "rehype-mermaid": "3.0.0",
    "remark-math": "6.0.0",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
