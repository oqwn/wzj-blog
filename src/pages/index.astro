---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';
import { postPath } from '../lib/paths';
import { blog } from '../config';

const posts = await getPosts();
---
<BaseLayout>
  <p class="site-description">{blog.description}</p>

  <section class="writing" aria-labelledby="writing-title">
    <div class="section-heading">
      <h1 id="writing-title">文章</h1>
      <span>{posts.length} 篇</span>
    </div>
    {posts.length === 0 ? (
      <p class="empty-state">暂无文章。</p>
    ) : (
      <ol class="post-list">
        {posts.map((post) => (
          <li class="post-row">
            <time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time>
            <article>
              <h2><a href={postPath(post.id)}>{post.data.title}</a></h2>
              {post.data.description && <p>{post.data.description}</p>}
              <div class="post-meta">
                <ul class="tags" aria-label="文章标签">{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>
              </div>
            </article>
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>
