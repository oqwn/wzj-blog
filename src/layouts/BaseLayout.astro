---
import { blog } from '../config';
import { withBase, localePath } from '../lib/paths';
import { ui, otherLang, type Lang } from '../lib/i18n';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import copyCodeScript from '../scripts/copy-code.js?raw';

interface Props {
  lang?: Lang;
  /** URL of this same page in the other language, when one exists. */
  alternate?: string;
  /** Marks the header's Posts link as current. */
  home?: boolean;
  title?: string;
  description?: string;
  article?: boolean;
  published?: Date;
  updated?: Date;
  noindex?: boolean;
}

const { lang = 'zh', alternate, home = false, title, article = false, published, updated, noindex = false } = Astro.props;
const site = blog[lang];
const t = ui[lang];
const other = otherLang(lang);
const description = Astro.props.description ?? site.description;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const scriptDigest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(copyCodeScript));
const scriptHash = btoa(String.fromCharCode(...new Uint8Array(scriptDigest)));
const scriptSource = article ? `'sha256-${scriptHash}'` : "'none'";
const policy = `default-src 'none'; script-src ${scriptSource}; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self'; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'`;
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={policy} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="theme-color" content="#f7faf9" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg?v=notebook')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={localePath(lang, 'rss.xml')} />
    {!noindex && alternate && <link rel="alternate" hreflang={t.htmlLang} href={canonical} />}
    {!noindex && alternate && <link rel="alternate" hreflang={ui[other].htmlLang} href={new URL(alternate, Astro.site)} />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content={t.ogLocale} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={localePath(lang)} aria-label={`${site.title} ${t.home}`}>
          <img class="brand-mark" src={withBase('favicon.svg?v=notebook')} width="28" height="28" alt="" aria-hidden="true" />
          <span>{site.title}</span>
        </a>
        <nav aria-label={t.nav}>
          <a href={localePath(lang)} aria-current={home ? 'page' : undefined}>{t.posts}</a>
          <a href={localePath(lang, 'rss.xml')}>RSS</a>
          <a class="lang-switch" href={alternate ?? localePath(other)} hreflang={ui[other].htmlLang} lang={ui[other].htmlLang} aria-label={t.switchLabel}>{t.switchTo}</a>
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {site.author}</span>
        <a href={blog.repository}>GitHub</a>
      </footer>
    </div>
    {article && <script is:inline set:html={copyCodeScript} />}
  </body>
</html>
