---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, readingMinutes, postSlug, getTranslation, type Post } from '../lib/posts';
import { localePath, postPath, categoryPath } from '../lib/paths';
import { ui, categoryLabels, otherLang, type Lang } from '../lib/i18n';

interface Props { lang: Lang; post: Post; newer?: Post; older?: Post; }
const { lang, post, newer, older } = Astro.props;
const t = ui[lang];
const { Content, headings } = await render(post);
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
const translation = await getTranslation(post);
const alternate = translation && postPath(otherLang(lang), postSlug(translation));
---
<BaseLayout lang={lang} alternate={alternate} title={post.data.title} description={post.data.description || post.data.title} article published={post.data.date} updated={post.data.updated}>
  <article>
    <header class="article-header">
      <a class="back-link" href={localePath(lang)}>{t.back}</a>
      <div class="article-labels">
        <a class="category-label" href={categoryPath(lang, post.data.category)}>{categoryLabels[lang][post.data.category]}</a>
        <ul class="tags" aria-label={t.tags}>{post.data.tags.map((tag) => <li>{tag}</li>)}</ul>
      </div>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="article-description">{post.data.description}</p>}
      <div class="article-info">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
        <span>{t.reading(readingMinutes(post.body))}</span>
        {post.data.updated && <span>{t.updated} <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated, lang)}</time></span>}
        {alternate && <a href={alternate} hreflang={ui[otherLang(lang)].htmlLang} lang={ui[otherLang(lang)].htmlLang}>{t.translation}</a>}
      </div>
    </header>
    <div class="article-grid">
      <div class="prose"><Content /></div>
      {toc.length > 1 && (
        <aside class="toc" aria-label={t.tocLabel}>
          <details>
            <summary>{t.toc}</summary>
            <ol>{toc.map((heading) => (
              <li class:list={{ 'toc-subheading': heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}</ol>
          </details>
        </aside>
      )}
    </div>
    <footer class="article-end">
      <a href={localePath(lang)}>{t.backEnd}</a>
      {(newer || older) && <nav class="post-navigation" aria-label={t.adjacent}>
        {newer && <a href={postPath(lang, postSlug(newer))}><span>{t.newer}</span>{newer.data.title}</a>}
        {older && <a href={postPath(lang, postSlug(older))}><span>{t.older}</span>{older.data.title}</a>}
      </nav>}
    </footer>
  </article>
</BaseLayout>
